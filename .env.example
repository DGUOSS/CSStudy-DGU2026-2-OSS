# backend/.env에 실제 값을 넣는다 (Neon 대시보드 → .env.local 탭)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
# 마이그레이션(Alembic)용, pooler 없는 주소
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# 로그인 토큰 서명 키. 무작위 긴 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
# 배포(https)에서만 true
COOKIE_SECURE=false
